{
  "label": "Hyperloop Data",
  "defaultSize": {
    "width": 1100,
    "height": 760
  },
  "noDataMessage": "Awaiting tuning telemetry",
  "fields": [
    {
      "name": "_numRows",
      "label": "Row count",
      "type": "slider",
      "min": 15,
      "max": 40,
      "step": 1,
      "default": 30
    }
  ],
  "formatter": [
    {
      "name": "errWarnPct",
      "label": "Warn Error (%)",
      "type": "text",
      "default": "5"
    },
    {
      "name": "errCritPct",
      "label": "Critical Error (%)",
      "type": "text",
      "default": "15"
    },
    {
      "name": "showOverview",
      "label": "Overview heatmap",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "showRowPreview",
      "label": "Row sparklines",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "modelAutoRotate",
      "label": "Auto-rotate",
      "type": "radio",
      "options": [
        "true",
        "false"
      ],
      "default": "true"
    },
    {
      "name": "colorScheme",
      "label": "Color Scheme",
      "type": "radio",
      "options": [
        "dark",
        "neon"
      ],
      "default": "dark"
    }
  ],
  "data": {
    "mode": "multi_row",
    "rowCountField": "_numRows",
    "relativeTimeColumn": "_time",
    "columns": [
