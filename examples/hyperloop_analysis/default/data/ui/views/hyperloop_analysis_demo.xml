<dashboard version="1.1" theme="dark">
  <label>Hyperloop Analysis — Demo</label>
  <description>
    Self-contained demo of the Hyperloop Analysis custom visualization — no data source
    required. Renders the full 399-column DH-X schema generated by | makeresults, so you
    can confirm the app installed correctly before wiring up live telemetry.
  </description>

  <row>
    <panel>
      <title>DH-X demo telemetry (generated)</title>
      <viz type="hyperloop_analysis.hyperloop_analysis">
        <search>
          <!-- Reuses the saved search bundled with the app (default/savedsearches.conf). -->
          <query>| savedsearch "Hyperloop Analysis - Demo"</query>
          <earliest>-2m</earliest>
          <latest>now</latest>
          <refresh>10s</refresh>
          <refreshType>delay</refreshType>
        </search>
        <option name="height">820</option>
        <option name="hyperloop_analysis.hyperloop_analysis.errWarnPct">5</option>
        <option name="hyperloop_analysis.hyperloop_analysis.errCritPct">15</option>
        <option name="hyperloop_analysis.hyperloop_analysis.colorScheme">dark</option>
        <option name="hyperloop_analysis.hyperloop_analysis.modelAutoRotate">true</option>
        <option name="hyperloop_analysis.hyperloop_analysis.partMap"></option>
        <option name="hyperloop_analysis.hyperloop_analysis.showRowPreview">true</option>
        <option name="hyperloop_analysis.hyperloop_analysis.sampleIntervalMs">0</option>
        <option name="hyperloop_analysis.hyperloop_analysis.sampleOffsetMs">0</option>
      </viz>
    </panel>
  </row>
</dashboard>
